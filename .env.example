# Copy to .env. Secrets belong only in .env or server secret storage.
PUBLIC_BASE_URL=http://localhost:8000
APP_PORT=8000
BIND_ADDRESS=127.0.0.1
DATABASE_PATH=data/max_students.sqlite3
DEMO_MODE=false
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_API_URL=https://platform-api2.max.ru
# disabled | polling | webhook. One polling worker per bot.
BOT_TRANSPORT=disabled
MAX_WEBHOOK_SECRET=
EDITOR_SUTD_KEY=
EDITOR_LETI_KEY=
MAINTAINER_KEY=
SESSION_TTL_SECONDS=86400
RETENTION_DAYS=180
# Optional OpenAI-compatible language helper. Main flow works without it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
